        <version>3.0.5</version>
        <configuration>
          <effort>Max</effort>
          <failOnError>false</failOnError>
          <threshold>Low</threshold>
          <xmlOutput>true</xmlOutput>
          <findbugsXmlOutputDirectory>${project.build.directory}/findbugs</findbugsXmlOutputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>analyze-compile</id>
            <phase>compile</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>cobertura-maven-plugin</artifactId>
        <version>2.5.1</version>
        <configuration>
          <formats>
            <format>xml</format>
          </formats>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>cobertura</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>2.3.2</version>
        <configuration>
          <source>8</source>
          <target>8</target>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
        <configuration>
          <warName>Spring3HibernateApp</warName>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.tomcat.maven</groupId>
        <artifactId>tomcat6-maven-plugin</artifactId>
        <version>2.2</version>
        <executions>
          <execution>
            <id>deploy-service</id>
            <goals>
              <goal>deploy</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <warFile>target/Spring3HibernateApp.war</warFile>
          <path>/</path>
          <update>true</update>
          <port>11011</port>
        </configuration>
      </plugin>

      <!-- ════════════════════════════════════════════════════════
           FIX: OWASP Dependency Check REMOVED from default build.
           ROOT CAUSE: Running dependency-check in every build forces
           a full NVD database download (354,872 records) that takes
           30–90 minutes without an NVD API key.
           SOLUTION: Plugin moved to the 'owasp' profile below.
           It only runs when Jenkins explicitly passes -Powasp, which
           happens in the dedicated weekly/nightly OWASP Scan stage.
           Normal CI builds (Build, Test, Deploy) are unaffected.
           ════════════════════════════════════════════════════════ -->

    </plugins>
  </build>

  <!-- ============================================================
       PROFILES
       ============================================================ -->
  <profiles>

    <!--
      owasp profile — activated explicitly with -Powasp
      ─────────────────────────────────────────────────
      WHY A PROFILE?
        The NVD database has ~350k records. Without an API key the
        download rate is throttled to ~1 record/sec → 30–90 min per
        build. Gating this behind a profile means:
          • Normal CI builds finish in minutes.
          • Security scans run on a schedule (nightly / weekly) or
            on-demand via the Jenkins "OWASP Scan" stage.

      HOW TO RUN MANUALLY:
        mvn verify -Powasp -DnvdApiKey=<your-key>

      HOW TO GET AN NVD API KEY (free):
        https://nvd.nist.gov/developers/request-an-api-key
        Then add it in Jenkins → Manage Credentials as a Secret Text
        with id 'NVD_API_KEY' and reference it via withCredentials.

      CACHE BEHAVIOUR:
        nvdDatafeedUrl + autoUpdate=true means the plugin only
        downloads records that changed since the last run.
        The cache lives in ~/.m2/repository/org/owasp/... by default.
        On the Jenkins agent this is preserved across builds so the
        second run (and every run after) is fast (< 2 min).
    -->
    <profile>
      <id>owasp</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>9.2.0</version>
            <!-- FIX: upgraded from 12.1.0 (does not exist on Maven
                 Central) to the latest stable 9.x release. -->
            <configuration>
              <format>HTML</format>

              <!-- FIX: supply NVD API key via Maven property.
                   Jenkins passes this with -DnvdApiKey=$$NVD_API_KEY.
                   Without a key the NVD throttles downloads to
                   ~1 rec/s; with a key the limit is 50 rec/s. -->
              <nvdApiKey>${nvdApiKey}</nvdApiKey>

              <!-- FIX: cap each HTTP request so a network blip does
                   not cause the stage to hang indefinitely. -->
              <connectionTimeout>10</connectionTimeout>
              <readTimeout>30</readTimeout>

              <!-- Retry transient NVD API errors up to 3 times before
                   failing. Combined with the timeout above, worst-case
                   wait per failed request is 3 × 30 s = 90 s. -->
              <nvdMaxRetryCount>3</nvdMaxRetryCount>

              <!-- Only fail the build for CRITICAL/HIGH CVEs (score ≥ 7).
                   Score 11 (original) is above the 0-10 CVSS scale
                   and therefore never triggers — effectively disabling
                   the gate. Changed to 7 to catch HIGH+ vulnerabilities. -->
              <failBuildOnCVSS>7</failBuildOnCVSS>

              <!-- Suppress false positives.  Create this file if/when
                   you have known-safe findings to document. -->
              <suppressionFile>owasp-suppressions.xml</suppressionFile>

              <!-- OSS Index hammers a separate service and adds latency.
                   Kept disabled (same as original). -->
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

